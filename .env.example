# FaliJedan server — kopiraj u .env i popuni

# Port API servera (u produkciji služi i frontend iz dist/)
PORT=8787
# Javna adresa aplikacije (za OAuth callback i sigurne kolačiće). Dev: http://localhost:5173
PUBLIC_URL=http://localhost:5173
# Demo podaci (Bijeljina), demo nalog i simulirani igrači. Za pravo lansiranje: false
DEMO_MODE=false
# Folder za lokalnu SQLite bazu (koristi se kad DATABASE_URL nije postavljen)
# DATA_DIR=./server/data

# ── Supabase / Postgres ─────────────────────────────────────────────
# Ako je postavljen DATABASE_URL, server koristi Postgres umjesto SQLite-a i sam kreira tabele.
# Supabase → dugme "Connect" → "Session pooler" → kopiraj URI:
# DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<regija>.pooler.supabase.com:5432/postgres
# Lozinka baze (Project Settings → Database). Ako je postaviš ovdje, u URL-u ostavi [YOUR-PASSWORD].
# DATABASE_PASSWORD=
# Šema u kojoj se kreiraju tabele (nije izložena Supabase Data API-ju)
# DATABASE_SCHEMA=falijedan
# SSL: require (podrazumijevano, šifrovano) | verify (+ DATABASE_CA_FILE) | disable (samo lokalni Postgres)
# DATABASE_SSL=require
# DATABASE_CA_FILE=./prod-ca-2021.crt
# Broj konekcija ka bazi
# DATABASE_POOL_MAX=5
# Vremenska zona za tekstove obavještenja
APP_TZ=Europe/Sarajevo

# Google prijava — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {PUBLIC_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple prijava — https://developer.apple.com/account/resources/identifiers (Services ID)
# Return URL: {PUBLIC_URL}/api/auth/apple/callback  (mora biti https)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Sadržaj .p8 ključa, novi redovi kao \n
APPLE_PRIVATE_KEY=
