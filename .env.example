# FaliJedan server — kopiraj u .env i popuni

# Port API servera (u produkciji služi i frontend iz dist/)
PORT=8787
# Javna adresa aplikacije (za OAuth callback i sigurne kolačiće). Dev: http://localhost:5173
PUBLIC_URL=http://localhost:5173
# Demo podaci (Bijeljina), demo nalog i simulirani igrači. Za pravo lansiranje: false
DEMO_MODE=false
# Folder za lokalnu SQLite bazu (koristi se kad DATABASE_URL nije postavljen)
# DATA_DIR=./server/data

# ── Supabase / Postgres ─────────────────────────────────────────────
# Ako je postavljen DATABASE_URL, server koristi Postgres umjesto SQLite-a i sam kreira tabele.
# Supabase → dugme "Connect" → "Session pooler" → kopiraj URI:
# DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<regija>.pooler.supabase.com:5432/postgres
# Lozinka baze (Project Settings → Database). Ako je postaviš ovdje, u URL-u ostavi [YOUR-PASSWORD].
# DATABASE_PASSWORD=
# Šema u kojoj se kreiraju tabele (nije izložena Supabase Data API-ju)
# DATABASE_SCHEMA=falijedan
# SSL: require (podrazumijevano, šifrovano) | verify (+ DATABASE_CA_FILE) | disable (samo lokalni Postgres)
# DATABASE_SSL=require
# DATABASE_CA_FILE=./prod-ca-2021.crt
# Broj konekcija ka bazi
# DATABASE_POOL_MAX=5

# ── Vercel ──────────────────────────────────────────────────────────
# Na Vercelu postavi DATABASE_URL, DATABASE_PASSWORD i DEMO_MODE u Project Settings → Environment Variables.
# Region funkcije se automatski uzima iz regiona Supabase baze; ručno (npr. fra1, dub1, iad1):
# FUNCTION_REGION=
# Vremenska zona za tekstove obavještenja
APP_TZ=Europe/Sarajevo

# Google prijava — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {PUBLIC_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple prijava — https://developer.apple.com/account/resources/identifiers (Services ID)
# Return URL: {PUBLIC_URL}/api/auth/apple/callback  (mora biti https)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Sadržaj .p8 ključa, novi redovi kao \n
APPLE_PRIVATE_KEY=

# ── Email: potvrda naloga i nova lozinka ─────────────────────────────
# Postavi JEDAN ključ. Brevo: besplatno 300 emailova/dan, radi i bez vlastite domene
# (app.brevo.com → SMTP & API → API Keys). Resend: besplatno 3000/mj, ali traži vlastitu domenu.
# Kad je email podešen, potvrda emaila je obavezna za prijave na termine, poruke i ocjene.
# BREVO_API_KEY=
# RESEND_API_KEY=
# EMAIL_FROM=tvoj.email@gmail.com        (Brevo: adresa potvrđena u Senders; Resend: adresa na tvojoj domeni)
# EMAIL_FROM_NAME=FaliJedan
# REQUIRE_EMAIL_VERIFICATION=true        (podrazumijevano: true kad je email podešen)

# ── Admin ───────────────────────────────────────────────────────────
# Super admin nalozi (email, više njih odvojeno zarezom): admin panel /admin — svi korisnici
# (izmjena, brisanje) i svi termini; korisnici im pišu preko "Kontaktiraj podršku".
# ADMIN_EMAILS=tvoj.email@gmail.com

# ── Sigurnost ───────────────────────────────────────────────────────
# Demo režim (javni demo nalog demo1234 + simulirani igrači) je u produkciji podrazumijevano ISKLJUČEN.
# Cloudflare Turnstile — zaštita registracije od botova (besplatno: dash.cloudflare.com → Turnstile)
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Vlastiti server iza reverse proxyja (nginx, Caddy…): IP klijenta iz X-Forwarded-For (na Vercelu ne treba)
# TRUST_PROXY=true
# Potpuna provjera TLS certifikata baze: DATABASE_SSL=verify + CA (Supabase → Database → SSL → Download certificate)
# DATABASE_CA_FILE=./prod-ca-2021.crt   ili (Vercel) DATABASE_CA="-----BEGIN CERTIFICATE-----
…"
